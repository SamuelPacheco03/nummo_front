# Variables de entorno (Vite). Todo lo que empieza con VITE_ se HORNEA en el bundle
# del cliente → NO pongas secretos aquí. Overrides locales sin versionar: .env.local
#
# Precedencia: una env var real del shell/CI (p. ej. en el build de despliegue) gana
# sobre estos archivos, así que en producción basta con exportar VITE_API_BASE_URL.

# ── API en el cliente ────────────────────────────────────────────────────────
# Base URL sobre la que se arman las rutas del API en runtime.
#   Vacío = MISMO ORIGEN (en dev lo resuelve el proxy de abajo; en prod, cuando el
#           front y el API comparten dominio).
#   Otro dominio: VITE_API_BASE_URL=https://api.tudominio.com
#   (requiere CORS con credenciales + cookies SameSite=None en el backend)
VITE_API_BASE_URL=

# ── Proxy de DEV (solo `pnpm dev`) ───────────────────────────────────────────
# A dónde reenvía Vite las rutas /api, /health, /openapi.json y /docs.
VITE_API_PROXY_TARGET=http://localhost:4010
