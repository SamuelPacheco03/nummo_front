# Plantilla de variables de entorno. Copia a `.env` (o `.env.local`) y ajusta.
# Todo lo VITE_ se hornea en el bundle del cliente → NO son secretos.
#
# En despliegue, exporta VITE_API_BASE_URL como env var del build (Vercel/Netlify/
# Docker build-arg/CI): una env var real gana sobre los archivos .env.

# Base URL del API en runtime. Vacío = mismo origen. Otro dominio → URL absoluta:
#   VITE_API_BASE_URL=https://api.tudominio.com
VITE_API_BASE_URL=

# Solo DEV: destino del proxy de Vite para /api, /health, /openapi.json, /docs.
VITE_API_PROXY_TARGET=http://localhost:4010
